{
  "conformance_suite": 1,
  "profile": "anthropic.messages.v1",
  "version": "2",
  "cancel": "messages.sse",
  "cases": [
    {
      "id": "messages.json",
      "endpoint": "messages",
      "note": "A budget a reasoning model can think in and still answer; a one-sentence answer stays short, so the cost is small",
      "request": {
        "model": "$model",
        "max_tokens": 512,
        "messages": [
          {
            "role": "user",
            "content": "Reply with one short sentence."
          }
        ]
      },
      "expect": {
        "framing": "json"
      },
      "content": [
        {
          "in": "body",
          "pointer": "/content/*/text"
        }
      ],
      "work_reports": true
    },
    {
      "id": "messages.sse",
      "endpoint": "messages",
      "note": "A budget a reasoning model can think in and still answer; a one-sentence answer stays short, so the cost is small",
      "request": {
        "model": "$model",
        "max_tokens": 512,
        "messages": [
          {
            "role": "user",
            "content": "Reply with one short sentence."
          }
        ],
        "stream": true
      },
      "expect": {
        "framing": "sse"
      },
      "content": [
        {
          "in": "any-event",
          "pointer": "/delta/text"
        }
      ],
      "work_reports": true
    },
    {
      "id": "messages.reasoning_off",
      "endpoint": "messages",
      "note": "Runs only for a runner whose envelope declares reasoning.default off: with no room to think, it must still answer",
      "when": {
        "/reasoning/default": "off"
      },
      "request": {
        "model": "$model",
        "max_tokens": 16,
        "messages": [
          {
            "role": "user",
            "content": "Reply with one short sentence."
          }
        ]
      },
      "expect": {
        "framing": "json"
      },
      "content": [
        {
          "in": "body",
          "pointer": "/content/*/text"
        }
      ]
    },
    {
      "id": "messages.invalid",
      "endpoint": "messages",
      "note": "No max_tokens: the request schema requires it",
      "request": {
        "model": "$model",
        "messages": [
          {
            "role": "user",
            "content": "Reply with one short sentence."
          }
        ]
      },
      "valid": false,
      "expect": {
        "kinds": [
          "input_invalid"
        ]
      }
    },
    {
      "id": "messages.context_tokens",
      "endpoint": "messages",
      "note": "A prompt past the runner's advertised limits.context_tokens is refused with a declared error",
      "limit": {
        "name": "context_tokens"
      },
      "request": {
        "model": "$model",
        "max_tokens": 1,
        "messages": [
          {
            "role": "user",
            "content": "$fill"
          }
        ]
      },
      "expect": {
        "kinds": [
          "input_unsupported"
        ]
      }
    },
    {
      "id": "messages.inline_cap",
      "endpoint": "messages",
      "note": "An inline input past the entry's max_bytes for /messages is refused with a declared error",
      "limit": {
        "input": "/messages"
      },
      "request": {
        "model": "$model",
        "max_tokens": 1,
        "messages": [
          {
            "role": "user",
            "content": "$fill"
          }
        ]
      },
      "expect": {
        "kinds": [
          "input_unsupported",
          "input_invalid"
        ]
      }
    },
    {
      "id": "messages.max_input_bytes",
      "endpoint": "messages",
      "note": "A body past the runner's advertised limits.max_input_bytes is refused with a declared error",
      "limit": {
        "name": "max_input_bytes"
      },
      "request": {
        "model": "$model",
        "max_tokens": 1,
        "messages": [
          {
            "role": "user",
            "content": "$fill"
          }
        ]
      },
      "expect": {
        "kinds": [
          "input_unsupported",
          "input_invalid"
        ]
      }
    }
  ]
}
