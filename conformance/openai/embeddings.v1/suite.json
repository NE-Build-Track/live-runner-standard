{
  "conformance_suite": 1,
  "profile": "openai.embeddings.v1",
  "version": "1",
  "cancel": "embeddings.json",
  "cases": [
    {
      "id": "embeddings.json",
      "endpoint": "embeddings",
      "request": {
        "model": "$model",
        "input": "The quick brown fox",
        "encoding_format": "float"
      },
      "expect": {
        "framing": "json"
      },
      "content": [
        {
          "in": "body",
          "pointer": "/data/0/embedding"
        }
      ],
      "work_reports": true
    },
    {
      "id": "embeddings.several",
      "endpoint": "embeddings",
      "request": {
        "model": "$model",
        "input": [
          "The quick brown fox",
          "jumps over the lazy dog"
        ]
      },
      "expect": {
        "framing": "json"
      },
      "content": [
        {
          "in": "body",
          "pointer": "/data/1/embedding"
        }
      ]
    },
    {
      "id": "embeddings.invalid",
      "endpoint": "embeddings",
      "note": "No input: the request schema requires it",
      "request": {
        "model": "$model"
      },
      "valid": false,
      "expect": {
        "kinds": [
          "input_invalid"
        ]
      }
    },
    {
      "id": "embeddings.inline_cap",
      "endpoint": "embeddings",
      "note": "An inline input past the entry's max_bytes for /input is refused with a declared error",
      "limit": {
        "input": "/input"
      },
      "request": {
        "model": "$model",
        "input": "$fill"
      },
      "expect": {
        "kinds": [
          "input_unsupported",
          "input_invalid"
        ]
      }
    },
    {
      "id": "embeddings.max_input_bytes",
      "endpoint": "embeddings",
      "note": "A body past the runner's advertised limits.max_input_bytes is refused with a declared error",
      "limit": {
        "name": "max_input_bytes"
      },
      "request": {
        "model": "$model",
        "input": "$fill"
      },
      "expect": {
        "kinds": [
          "input_unsupported",
          "input_invalid"
        ]
      }
    }
  ]
}
