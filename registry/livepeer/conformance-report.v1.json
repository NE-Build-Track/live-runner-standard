{
  "openapi": "3.1.0",
  "info": {
    "title": "livepeer.conformance-report.v1",
    "version": "1",
    "description": "The report the builder tool's conform command writes after running one profile's suite against one runner. It is the same schema as schemas/conformance-report.v1.schema.json. Reports aren't signed."
  },
  "components": {
    "schemas": {
      "ConformanceReport": {
        "title": "Conformance report v1",
        "description": "What the builder tool's conform command writes after running one profile's suite against one runner. Reports aren't signed; each gateway decides whether to require one. See SPEC.md.",
        "type": "object",
        "required": [
          "conformance_report",
          "runner_id",
          "deployment_revision",
          "profile",
          "suite",
          "tool",
          "started_at",
          "finished_at",
          "checks",
          "pass"
        ],
        "properties": {
          "conformance_report": {
            "const": 1
          },
          "runner_id": {
            "type": "string",
            "minLength": 1
          },
          "deployment_revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+\\.v[1-9][0-9]*$"
          },
          "registry_release": {
            "description": "The registry release the suite came from, such as 2026.11.1",
            "type": "string",
            "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[1-9][0-9]*$"
          },
          "suite": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "tool": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "result"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "skip"
                  ]
                },
                "detail": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "additionalProperties": false
            }
          },
          "pass": {
            "description": "True only when no check failed",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "x-livepeer": {
    "registry_entry": 1,
    "profile": "livepeer.conformance-report.v1",
    "kind": "shared"
  }
}
