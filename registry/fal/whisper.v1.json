  "x-livepeer": {
    "registry_entry": 1,
    "profile": "fal.whisper.v1",
    "kind": "profile",
    "extends": "fal.queue.v1",
    "mode": "single-shot",
    "capabilities": [
      "transcription",
      "translation"
    ],
    "admission": {
      "default": "candidate"
    },
    "attempts": "caller",
    "readiness": "The adapter has loaded its pinned endpoint's route and schema bundle and holds the operator's fal key. It doesn't call fal, so it doesn't yet check the vendor as SPEC asks of a proxy; unknown whether it will."
  }
