              "stage": {
                "description": "Where it failed: submitting to fal, polling its status, reading its result, or the deadline",
                "enum": [
                  "submit",
                  "status",
                  "result",
                  "timeout"
                ]
              },
              "status": {
                "description": "The error's HTTP status: the answer's own before the headers were sent; after that, fal's status, or 502 or 504 from the adapter",
                "type": "integer",
                "minimum": 400,
                "maximum": 599
