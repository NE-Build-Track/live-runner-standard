{
  "openapi": "3.1.0",
  "info": {
    "title": "fal.ffmpeg-api-loudnorm.v1",
    "version": "1",
    "description": "fal endpoint fal-ai/ffmpeg-api/loudnorm, model fal:fal-ai/ffmpeg-api/loudnorm, through the Livepeer fal route adapter. The request and output schemas are fal's own, from its public queue OpenAPI (x-source), with long descriptions shortened and examples and fal's UI hints left out. Behavior is fal.queue.v1's.",
    "x-source": {
      "endpoint_id": "fal-ai/ffmpeg-api/loudnorm",
      "openapi_url": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/ffmpeg-api/loudnorm",
      "sha256": "0935f95393e414c5dd31652be25dc5272f8f59ddb1dc3dee88f616acea5c80d9"
    }
  },
  "paths": {
    "/": {
      "post": {
        "operationId": "run",
        "summary": "Run fal endpoint fal-ai/ffmpeg-api/loudnorm",
        "description": "The body is fal's input for fal-ai/ffmpeg-api/loudnorm, forwarded to fal unchanged; a success answer carries fal's output under `output`. Behaves as fal.queue.v1 describes. Each URL output pointer names the URL itself, and a `*` stands for every item of a list. URL fields nested deeper aren't listed in inputs or outputs; the schemas show them.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FfmpegApiLoudnormInput"
              },
              "examples": {
                "fal": {
                  "summary": "Built from fal's own example and default values",
                  "value": {
                    "audio_url": "https://storage.googleapis.com/falserverless/example_inputs/ffmpeg-audio.wav"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "fal's result, or an error that came after the headers were sent. The body tells them apart: a result has `output`, an error has `error`.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AdapterResult"
                    },
                    {
                      "$ref": "#/components/schemas/AdapterError"
                    }
                  ]
                }
              }
            }
          },
          "4XX": {
            "description": "Refused before fal accepted the request: the body is too large, or fal refused it at submit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdapterError"
                }
              }
            }
          },
          "5XX": {
            "description": "fal failed or was unreachable at submit, or the deadline passed before fal accepted the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdapterError"
                }
              }
            }
          }
        },
        "x-livepeer": {
          "framing": "json",
          "success": {
            "status": [
              200
            ],
            "final": [
              {
                "in": "body",
                "pointer": "/output",
                "present": true
              }
            ]
          },
          "errors": [
            {
              "in": "body",
              "pointer": "/error/stage",
              "equals": "timeout",
              "kind": "deadline_exceeded",
              "note": "The adapter's deadline passed: before fal accepted the request (a 504 with no request ID), or while fal was working (a 200 with error.status 504). fal may still finish and charge the operator; once fal has accepted it, the request ID is in the header and at /request_id"
            },
            {
              "in": "body",
              "pointer": "/error/status",
              "equals": 422,
              "kind": "input_invalid",
              "note": "fal refused the input, at submit or when its result was read after queueing (then in a 200); fal's detail is in /error/upstream_body"
            },
            {
              "in": "body",
              "pointer": "/error/status",
              "equals": 400,
              "kind": "input_invalid",
              "note": "fal refused the request, at submit or when its result was read after queueing"
            },
            {
              "status": 413,
              "kind": "input_invalid",
              "note": "The body is larger than the adapter's max_request_bytes, which the operator sets (1 MiB by default)"
            },
            {
              "in": "body",
              "pointer": "/error/stage",
              "equals": "status",
              "kind": "upstream_failed",
              "note": "In a 200: fal reported that the request failed or reached an unknown state, or its status couldn't be read; error.status is fal's status, or 502. Unknown: how fal's status marks an input it refuses after queueing, so such refusals land here too; fal's detail is in /error/upstream_body"
            },
            {
              "in": "body",
              "pointer": "/error/stage",
              "equals": "result",
              "kind": "upstream_failed",
              "note": "In a 200: fal finished, but its result couldn't be read; error.status is fal's status, or 502. The result may still be collectable with the request ID"
            },
            {
              "status": 401,
              "kind": "unavailable",
              "note": "At submit: fal refused the operator's fal key"
            },
            {
              "status": 403,
              "kind": "unavailable",
              "note": "At submit: fal refused the operator's fal key for this endpoint"
            },
            {
              "status": 404,
              "kind": "unavailable",
              "note": "At submit: fal doesn't know the pinned endpoint"
            },
            {
              "status": 429,
              "kind": "busy",
              "note": "At submit: fal is limiting the operator's requests"
            },
            {
              "status": 500,
              "kind": "upstream_failed",
              "note": "At submit: fal failed"
            },
            {
              "status": 502,
              "kind": "upstream_failed",
              "note": "At submit: fal was unreachable, or answered without a request ID; fal may have queued the request, and no request ID came back"
            },
            {
              "status": 503,
              "kind": "unavailable",
              "note": "At submit: fal is unavailable"
            },
            {
              "status": 504,
              "kind": "deadline_exceeded",
              "note": "At submit: fal timed out; it may have queued the request, and no request ID came back"
            }
          ],
          "inputs": [
            {
              "kind": "inline",
              "max_bytes": 1048576
            },
            {
              "field": "/audio_url",
              "kind": "url",
              "origin": "public",
              "media_types": [
                "audio/*"
              ]
            }
          ],
          "outputs": [
            {
              "field": "/output/audio/url",
              "kind": "url",
              "media_types": [
                "audio/*"
              ],
              "expires": {
                "after_s": 604800
              }
            }
          ],
          "cost_hint": {
            "note": "A call costs the runner's fixed PriceInfo, charged when the node reserves the call, before the adapter runs and whatever the outcome. The answer's billable_units is fal's own count for the request, from its X-Fal-Billable-Units header (null when absent), in a unit that differs by endpoint: a receipt to compare afterwards, not the wholesale charge."
          },
          "recovery": {
            "request_id": {
              "in": "header",
              "header": "Livepeer-Provider-Request-Id"
            },
            "note": "The header comes with the answer's headers as soon as fal accepts the request, and the body repeats it at /request_id. The adapter has no operation that returns a late result and keeps nothing once it has answered. Collecting one needs fal's queue API (GET https://queue.fal.run/<fal app>/requests/<request ID>, where the fal app is the endpoint ID's first two segments, or three under comfy/ and workflows/) and the operator's fal key, so today only the operator can collect a late result. With sync_mode set, fal keeps no copy to collect."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FfmpegApiLoudnormInput": {
        "properties": {
          "audio_url": {
            "description": "URL of the audio file to normalize",
            "title": "Audio Url",
            "type": "string"
          },
          "dual_mono": {
            "default": false,
            "description": "Treat mono input files as dual-mono for correct EBU R128 measurement on stereo systems",
            "title": "Dual Mono",
            "type": "boolean"
          },
          "integrated_loudness": {
            "default": -18,
            "description": "Integrated loudness target in LUFS.",
            "maximum": -5,
            "minimum": -70,
            "title": "Integrated Loudness",
            "type": "number"
          },
          "linear": {
            "default": false,
            "description": "Use linear normalization mode (single-pass). If false, uses dynamic mode (two-pass for better quality).",
            "title": "Linear",
            "type": "boolean"
          },
          "loudness_range": {
            "default": 7,
            "description": "Loudness range target in LU",
            "maximum": 20,
            "minimum": 1,
            "title": "Loudness Range",
            "type": "number"
          },
          "measured_i": {
            "anyOf": [
              {
                "maximum": 0,
                "minimum": -99,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Measured integrated loudness of input file in LUFS. Required for linear mode.",
            "title": "Measured I"
          },
          "measured_lra": {
            "anyOf": [
              {
                "maximum": 99,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Measured loudness range of input file in LU. Required for linear mode.",
            "title": "Measured Lra"
          },
          "measured_thresh": {
            "anyOf": [
              {
                "maximum": 0,
                "minimum": -99,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Measured threshold of input file in LUFS. Required for linear mode.",
            "title": "Measured Thresh"
          },
          "measured_tp": {
            "anyOf": [
              {
                "maximum": 99,
                "minimum": -99,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Measured true peak of input file in dBTP. Required for linear mode.",
            "title": "Measured Tp"
          },
          "offset": {
            "default": 0,
            "description": "Offset gain in dB applied before the true-peak limiter",
            "maximum": 99,
            "minimum": -99,
            "title": "Offset",
            "type": "number"
          },
          "print_summary": {
            "default": false,
            "description": "Return loudness measurement summary with the normalized audio",
            "title": "Print Summary",
            "type": "boolean"
          },
          "true_peak": {
            "default": -0.1,
            "description": "Maximum true peak in dBTP.",
            "maximum": 0,
            "minimum": -9,
            "title": "True Peak",
            "type": "number"
          }
        },
        "required": [
          "audio_url"
        ],
        "title": "LoudnormInput",
        "type": "object",
        "x-fal-order-properties": [
          "audio_url",
          "integrated_loudness",
          "true_peak",
          "loudness_range",
          "offset",
          "linear",
          "dual_mono",
          "print_summary",
          "measured_i",
          "measured_lra",
          "measured_tp",
          "measured_thresh"
        ]
