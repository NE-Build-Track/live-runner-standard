  "x-livepeer": {
    "registry_entry": 1,
    "profile": "fal.ffmpeg-api-loudnorm.v1",
    "kind": "profile",
    "extends": "fal.queue.v1",
    "mode": "single-shot",
    "capabilities": [
      "media-tools"
    ],
    "admission": {
