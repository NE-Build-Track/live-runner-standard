            }
          },
          "request_id": {
            "description": "fal's request ID, once fal has accepted the request",
            "type": "string",
            "minLength": 1
          },
          "schema_sha256": {
            "description": "The sha256 of the adapter's schema bundle (GET /schema)",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
