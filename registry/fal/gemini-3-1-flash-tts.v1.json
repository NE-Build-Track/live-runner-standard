              "examples": {
                "fal": {
                  "summary": "Built from fal's own example and default values",
                  "value": {
                    "prompt": "I can't believe it worked! [laughing] After all those hours of debugging [sigh] it was just a missing semicolon."
                  }
                }
              }
            }
          }
        },
