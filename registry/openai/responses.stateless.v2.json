                "minimum": 0
              }
            }
          }
        }
      },
      "Response": {
        "description": "A response. completed and incomplete are success, and incomplete_details says why an incomplete one stopped; either carries usage. Reasoning arrives as reasoning items, apart from the message's output_text",
        "type": "object",
        "required": [
          "id",
          "object",
          "created_at",
          "status",
          "model",
          "output"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "response"
          },
          "created_at": {
            "type": "number"
          },
          "status": {
            "enum": [
              "completed",
              "incomplete",
              "failed",
              "cancelled",
              "in_progress",
              "queued"
            ]
          },
          "model": {
            "type": "string"
          },
          "output": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "required": [
            "usage"
          ],
          "properties": {
            "usage": {
              "$ref": "#/components/schemas/Usage"
            }
          }
        }
      },
      "OutputItem": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "type",
              "role",
              "content"
            ],
            "properties": {
              "type": {
                "const": "message"
              },
              "id": {
                "type": "string"
              },
              "role": {
                "const": "assistant"
              },
              "status": {
                "type": "string"
              },
              "content": {
                "type": "array",
