                        "refusal"
                      ],
                      "properties": {
                        "type": {
                          "const": "refusal"
                        },
                        "refusal": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "call_id",
              "name",
              "arguments"
            ],
            "properties": {
              "type": {
                "const": "function_call"
              },
              "id": {
                "type": "string"
              },
              "call_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "reasoning"
              },
              "id": {
                "type": "string"
              },
              "summary": {
                "type": "array"
              },
              "content": {
                "type": [
                  "array",
