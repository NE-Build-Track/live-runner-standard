{
  "openapi": "3.1.0",
  "info": {
    "title": "openai.responses.stateless.v2",
    "version": "2",
    "description": "OpenAI Responses without stored state: each call carries its whole input, sets store to false, and the runner keeps nothing once it answers. v2 counts an incomplete answer, one cut short as incomplete_details.reason says (such as max_output_tokens), as success, as openai.chat.v2 counts a finish_reason of length; v1 mapped it to output_failed. v2 also passes tools, input items and content of types it doesn't describe, such as Codex's custom and web_search tools, to the runner; v1 refused them. Drafted from NE-Build-Track/inference-gateway at e5b47d8."
  },
  "paths": {
    "/v1/responses": {
      "post": {
        "operationId": "responses",
        "summary": "Respond to an input, keeping no state",
        "description": "Responds to text and images, with function calls, and keeps no state: store is false, and stored responses, conversations, files and background jobs aren't part of this profile. Images travel inline as base64 data URLs, and the runner fetches no URLs. Tools, input items and content of types this entry doesn't describe, such as built-in tools, pass to the runner, which serves, ignores or refuses them; it still fetches no URLs and keeps no state. With stream set to true the answer is a stream of events that ends with the whole response. An answer cut short by max_output_tokens or a content filter is still an answer: its status is incomplete, incomplete_details says why, and usage is reported.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseRequest"
              },
              "examples": {
                "text": {
                  "value": {
                    "model": "qwen3.8-27b",
                    "input": "What is Livepeer?",
                    "store": false,
                    "max_output_tokens": 128
                  }
                },
                "stream": {
                  "value": {
                    "model": "qwen3.8-27b",
                    "input": "What is Livepeer?",
                    "store": false,
                    "stream": true
                  }
                },
                "image": {
                  "value": {
                    "model": "qwen3.8-27b",
                    "store": false,
                    "input": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "input_text",
                            "text": "What color is this image?"
                          },
                          {
                            "type": "input_image",
                            "image_url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
                          }
                        ]
                      }
                    ]
                  }
                },
                "tool_result": {
                  "value": {
                    "model": "qwen3.8-27b",
                    "store": false,
                    "input": [
                      {
                        "role": "user",
                        "content": "What's the weather in Boston?"
                      },
                      {
                        "type": "function_call",
                        "call_id": "call_1",
                        "name": "weather",
                        "arguments": "{\"city\":\"Boston\"}"
                      },
                      {
                        "type": "function_call_output",
                        "call_id": "call_1",
                        "output": "Sunny, 18 °C"
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "name": "weather",
                        "description": "Current weather for a city",
                        "parameters": {
                          "type": "object",
                          "properties": {
                            "city": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "city"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The response: one JSON answer, or a stream of server-sent events when stream is true",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                },
                "examples": {
                  "completed": {
                    "value": {
                      "id": "resp_7f3a",
                      "object": "response",
                      "created_at": 1793952000,
                      "model": "qwen3.8-27b",
                      "status": "completed",
                      "output": [
                        {
                          "type": "message",
                          "id": "msg_1",
                          "role": "assistant",
                          "status": "completed",
                          "content": [
                            {
                              "type": "output_text",
                              "text": "Livepeer is a decentralized video and AI compute network.",
                              "annotations": []
                            }
                          ]
                        }
                      ],
                      "usage": {
                        "input_tokens": 15,
                        "output_tokens": 9,
                        "total_tokens": 24,
                        "input_tokens_details": {
                          "cached_tokens": 0
                        },
                        "output_tokens_details": {
                          "reasoning_tokens": 0
                        }
                      },
                      "error": null,
                      "incomplete_details": null
                    }
                  },
                  "incomplete": {
                    "value": {
                      "id": "resp_7f3a",
                      "object": "response",
                      "created_at": 1793952000,
                      "model": "qwen3.8-27b",
                      "status": "incomplete",
                      "output": [
                        {
                          "type": "message",
                          "id": "msg_1",
                          "role": "assistant",
                          "status": "completed",
                          "content": [
                            {
                              "type": "output_text",
                              "text": "Livepeer is a decentralized video and AI compute network.",
                              "annotations": []
                            }
                          ]
                        }
                      ],
                      "usage": {
                        "input_tokens": 15,
                        "output_tokens": 16,
                        "total_tokens": 31,
                        "input_tokens_details": {
                          "cached_tokens": 0
                        },
                        "output_tokens_details": {
                          "reasoning_tokens": 0
                        }
                      },
                      "incomplete_details": {
                        "reason": "max_output_tokens"
                      }
                    }
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseEvent"
                },
                "examples": {
                  "created": {
                    "value": {
                      "type": "response.created",
                      "sequence_number": 0,
                      "response": {
                        "id": "resp_7f3a",
                        "object": "response",
                        "created_at": 1793952000,
                        "model": "qwen3.8-27b",
                        "status": "in_progress",
                        "output": [],
                        "usage": null
                      }
                    }
                  },
                  "delta": {
                    "value": {
                      "type": "response.output_text.delta",
                      "sequence_number": 4,
                      "item_id": "msg_1",
                      "output_index": 0,
                      "content_index": 0,
                      "delta": "Livepeer"
                    }
                  },
                  "completed": {
                    "value": {
                      "type": "response.completed",
                      "sequence_number": 12,
                      "response": {
                        "id": "resp_7f3a",
                        "object": "response",
                        "created_at": 1793952000,
                        "model": "qwen3.8-27b",
                        "status": "completed",
                        "output": [
                          {
                            "type": "message",
                            "id": "msg_1",
                            "role": "assistant",
                            "status": "completed",
                            "content": [
                              {
                                "type": "output_text",
                                "text": "Livepeer is a decentralized video and AI compute network.",
                                "annotations": []
                              }
                            ]
                          }
                        ],
                        "usage": {
                          "input_tokens": 15,
                          "output_tokens": 9,
                          "total_tokens": 24,
                          "input_tokens_details": {
                            "cached_tokens": 0
                          },
                          "output_tokens_details": {
                            "reasoning_tokens": 0
                          }
                        },
                        "error": null,
                        "incomplete_details": null
                      }
                    }
                  },
                  "error": {
                    "value": {
                      "type": "error",
                      "sequence_number": 5,
                      "code": null,
                      "message": "The engine stopped during generation",
                      "param": null
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error, in the OpenAI format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                },
                "examples": {
                  "invalid": {
                    "value": {
                      "error": {
                        "message": "store must be false",
                        "type": "BadRequestError",
                        "param": "store",
                        "code": 400
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-livepeer": {
          "framing": [
            "json",
            "sse"
          ],
          "success": {
            "status": [
              200
            ],
            "final": [
              {
                "framing": "json",
                "in": "body",
                "pointer": "/status",
                "matches": "^(completed|incomplete)$"
              },
              {
                "framing": "sse",
                "in": "last-event",
                "pointer": "/type",
                "matches": "^response\\.(completed|incomplete)$"
              }
            ]
          },
          "errors": [
            {
              "framing": "json",
              "status": 200,
              "in": "body",
              "pointer": "/status",
              "equals": "failed",
              "kind": "internal"
            },
            {
              "framing": "sse",
              "in": "last-event",
              "pointer": "/type",
              "equals": "response.failed",
              "kind": "internal"
            },
            {
              "framing": "sse",
              "in": "any-event",
              "pointer": "/type",
              "equals": "error",
              "kind": "internal",
              "note": "An error event in a stream, wherever it comes"
            },
            {
              "framing": "json",
              "status": 400,
              "in": "body",
              "pointer": "/error/type",
              "equals": "exceed_context_size_error",
              "kind": "input_unsupported",
              "note": "The prompt doesn't fit the runner's context, as llama.cpp reports it"
            },
            {
              "framing": "json",
              "status": 400,
              "in": "body",
              "pointer": "/error/message",
              "matches": "context length|maximum model length|context size",
              "kind": "input_unsupported",
              "note": "The prompt doesn't fit the runner's context, as vLLM and Ollama report it"
            },
            {
              "framing": "json",
              "status": 400,
              "in": "body",
              "pointer": "/message",
              "matches": "context length|maximum model length|context size",
              "kind": "input_unsupported",
              "note": "The prompt doesn't fit the runner's context, as SGLang reports it"
            },
            {
              "status": 400,
              "kind": "input_invalid",
              "note": "The request is malformed or holds a value the runner refuses"
            },
            {
              "status": 404,
              "kind": "unavailable",
              "note": "The runner doesn't serve the requested model; no work started"
            },
            {
              "status": 413,
              "kind": "input_unsupported",
              "note": "The request is larger than a limit the runner enforces, such as limits.max_input_bytes"
            },
            {
              "status": 422,
              "kind": "input_invalid",
              "note": "A request validation error, as FastAPI-based servers report it"
            },
            {
              "status": 429,
              "kind": "busy",
              "note": "The runner is at capacity; no work started"
            },
            {
              "status": 500,
              "kind": "internal"
            },
            {
              "status": 503,
              "kind": "unavailable",
              "note": "The runner is loading, or its queue is full; no work started"
            }
          ],
          "work_reports": [
            {
              "framing": "json",
              "measure": "input_tokens",
              "in": "body",
              "pointer": "/usage/input_tokens"
            },
            {
              "framing": "json",
              "measure": "output_tokens",
              "in": "body",
              "pointer": "/usage/output_tokens"
            },
            {
              "framing": "sse",
              "measure": "input_tokens",
              "in": "last-event",
              "pointer": "/response/usage/input_tokens"
            },
            {
              "framing": "sse",
              "measure": "output_tokens",
              "in": "last-event",
              "pointer": "/response/usage/output_tokens"
            }
          ],
          "inputs": [
            {
              "field": "/input",
              "kind": "inline",
              "max_bytes": 8388608,
              "media_types": [
                "text/plain",
                "image/png",
                "image/jpeg",
                "image/gif",
                "image/webp"
              ]
            }
          ],
          "outputs": [
            {
              "field": "/output",
              "kind": "inline",
              "max_bytes": 8388608
            }
          ],
          "attempts": "gateway"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseRequest": {
        "description": "A Responses request that carries its whole input and keeps no state. Fields not listed here pass to the runner unchanged, such as a runner's own sampling settings",
        "type": "object",
        "required": [
          "model",
          "input",
          "store"
        ],
        "properties": {
          "model": {
            "description": "The model name the runner serves",
            "type": "string",
            "minLength": 1
          },
          "input": {
            "description": "The input: text, or a list of items. Messages, function calls, function results and reasoning items are checked in full; items of other types, such as custom_tool_call, pass",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/InputItem"
                }
              }
            ]
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ],
            "description": "A system message placed before the input"
          },
          "store": {
            "description": "Always false: the runner keeps nothing after it answers",
            "const": false
          },
          "background": {
            "description": "Always false when present: the answer comes on this connection",
            "const": false
          },
          "previous_response_id": {
            "not": {},
            "description": "Not part of this profile: a call can't refer to a stored response"
          },
          "conversation": {
            "not": {},
            "description": "Not part of this profile: a call can't refer to a stored conversation"
          },
          "stream": {
            "description": "true for a stream of server-sent events; false or absent for one JSON answer",
            "type": "boolean"
          },
          "max_output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "The most tokens to generate, including reasoning tokens"
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 2
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "top_logprobs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 20
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "anyOf": [
              {
                "enum": [
                  "none",
                  "auto",
                  "required"
                ]
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "name"
                ],
                "properties": {
                  "type": {
                    "const": "function"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              {
                "description": "A choice of a tool of a type this entry doesn't describe, such as a custom tool or web_search. The profile doesn't promise it: it passes to the runner, which serves it, ignores it or refuses the request as invalid",
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "not": {
                      "enum": [
                        "function"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "parallel_tool_calls": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "text": {
            "description": "The output text's format",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "format": {
                "$ref": "#/components/schemas/TextFormat"
              }
            }
          },
          "reasoning": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "effort": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "include": {
            "description": "Extra output to include, such as reasoning.encrypted_content",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "truncation": {
            "enum": [
              "auto",
              "disabled",
              null
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "InputItem": {
        "anyOf": [
          {
            "description": "A message. Its content is text, or a list of text and image parts",
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "type": {
                "const": "message"
              },
              "role": {
                "enum": [
                  "system",
                  "developer",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/InputContent"
                    }
                  }
                ]
              }
            }
          },
          {
            "description": "A function call an earlier answer made",
            "type": "object",
            "required": [
              "type",
              "call_id",
              "name",
              "arguments"
            ],
            "properties": {
              "type": {
                "const": "function_call"
              },
              "call_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "arguments": {
                "description": "The arguments, as JSON text",
                "type": "string"
              }
            }
          },
          {
            "description": "The result of a function call",
            "type": "object",
            "required": [
              "type",
              "call_id",
              "output"
            ],
            "properties": {
              "type": {
                "const": "function_call_output"
              },
              "call_id": {
                "type": "string"
              },
              "output": {
                "description": "The result, as text or as a list of content parts",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/InputContent"
                    }
                  }
                ]
              }
            }
          },
          {
            "description": "A reasoning item an earlier answer returned",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "reasoning"
              },
              "summary": {
                "type": "array"
              },
              "encrypted_content": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "description": "An input item of a type this entry doesn't describe, such as custom_tool_call or custom_tool_call_output. The profile doesn't promise it: it passes to the runner, which serves it, ignores it or refuses the request as invalid",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "not": {
                  "enum": [
                    "message",
                    "function_call",
                    "function_call_output",
                    "reasoning"
                  ]
                }
              }
            }
          }
        ]
      },
      "InputContent": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "enum": [
                  "input_text",
                  "output_text"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "description": "An image, inline as a base64 data URL. The runner fetches no URLs and reads no stored files",
            "type": "object",
            "required": [
              "type",
              "image_url"
            ],
            "properties": {
              "type": {
                "const": "input_image"
              },
              "image_url": {
                "type": "string",
                "pattern": "^data:image/[a-z0-9.+-]+;base64,[A-Za-z0-9+/]+={0,2}$",
                "x-media": {
                  "by": "inline",
                  "accept": [
                    "image/png",
                    "image/jpeg",
                    "image/gif",
                    "image/webp"
                  ]
                }
              },
              "detail": {
                "enum": [
                  "auto",
                  "low",
                  "high"
                ]
              },
              "file_id": {
                "not": {},
                "description": "Not part of this profile: a stored file"
              }
            }
          },
          {
            "description": "A content part of a type this entry doesn't describe, such as input_file. The profile doesn't promise it: it passes to the runner, which serves it, ignores it or refuses the request as invalid",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "not": {
                  "enum": [
                    "input_text",
                    "output_text",
                    "input_image"
                  ]
                }
              }
            }
          }
        ]
      },
      "FunctionTool": {
        "description": "A function the model may call",
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "const": "function"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "description": "A JSON Schema for the arguments",
            "type": [
              "object",
              "null"
            ]
          },
          "strict": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "Tool": {
        "description": "A tool the model may call: a function, checked in full, or a tool of another type, which passes",
        "anyOf": [
          {
            "$ref": "#/components/schemas/FunctionTool"
          },
          {
            "description": "A tool of a type this entry doesn't describe, such as custom or web_search. The profile doesn't promise it: it passes to the runner, which serves it, ignores it or refuses the request as invalid",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "not": {
                  "enum": [
                    "function"
                  ]
                }
              }
            }
          }
        ]
      },
      "TextFormat": {
        "description": "Text, any JSON object, or JSON matching a schema",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "text",
              "json_object",
              "json_schema"
            ]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "strict": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "if": {
          "properties": {
            "type": {
              "const": "json_schema"
            }
          }
        },
        "then": {
          "required": [
            "name",
            "schema"
          ]
        }
      },
      "Usage": {
        "description": "Token counts. input_tokens includes any cached tokens",
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
