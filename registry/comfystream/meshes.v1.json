                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "x-livepeer": {
          "framing": "json",
          "success": {
            "status": [
              200
            ]
          },
          "errors": [
            {
              "status": 400,
              "kind": "input_invalid"
            },
            {
              "status": 413,
              "kind": "input_unsupported"
            },
            {
              "status": 415,
              "kind": "input_unsupported"
            },
            {
              "status": 502,
              "kind": "upstream_failed"
            },
            {
              "status": 503,
              "kind": "busy"
            },
            {
              "status": 504,
              "kind": "deadline_exceeded"
            }
          ]
        }
      }
    }
  },
  "x-livepeer": {
    "registry_entry": 1,
    "profile": "comfystream.meshes.v1",
    "kind": "profile",
    "mode": "single-shot",
    "capabilities": [
      "image-to-3d"
    ],
    "admission": {
      "default": "private",
      "reason": "Local profile pending independent conformance and registry review"
    },
    "attempts": "caller"
  }
