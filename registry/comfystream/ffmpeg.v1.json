        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "properties": {
                  "fps": {
                    "default": 4,
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "tracks": {
                    "items": {
                      "additionalProperties": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "keyframes": {
                          "items": {
                            "additionalProperties": true,
                            "properties": {
                              "duration": {
                                "description": "Length of this keyframe in milliseconds.",
                                "minimum": 0,
                                "type": "number"
                              },
                              "timestamp": {
                                "minimum": 0,
                                "type": "number"
                              },
                              "url": {
                                "minLength": 1,
                                "type": "string"
                              }
                            },
                            "required": [
                              "url"
                            ],
                            "type": "object"
                          },
                          "minItems": 1,
                          "type": "array"
                        },
                        "type": {
                          "enum": [
                            "video",
                            "audio",
                            "image"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "keyframes"
