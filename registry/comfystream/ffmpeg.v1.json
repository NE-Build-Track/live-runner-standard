    "/batch/scale-video": {
      "post": {
        "operationId": "scale_video",
        "summary": "Native FFmpeg scale-video",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "properties": {
                  "height": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "mode": {
                    "default": "pad",
                    "enum": [
                      "pad",
                      "crop",
                      "stretch"
                    ],
                    "type": "string"
                  },
                  "video_url": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "width": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "video_url"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result: metadata or media receipt; publication uses caller-supplied stamps",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error object with error.message and error.status"
          }
        },
        "x-livepeer": {
          "framing": "json",
          "success": {
            "status": [
              200
            ]
          },
          "errors": [
            {
              "status": 400,
              "kind": "input_invalid"
            },
            {
              "status": 404,
              "kind": "unavailable"
            },
            {
              "status": 413,
              "kind": "input_unsupported"
            },
            {
              "status": 500,
              "kind": "internal"
            },
            {
              "status": 502,
              "kind": "upstream_failed"
