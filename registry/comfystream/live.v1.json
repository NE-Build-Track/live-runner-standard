  "paths": {
    "/stream": {
      "post": {
        "operationId": "stream",
        "summary": "ComfyStream session stream",
        "description": "Existing session control protocol. Session identity is supplied by the orchestrator; parameters depend on the operator-installed pipeline. See the runner /status for its enforced parameter schema. Returns trickle input/output channel URLs; media is transported over those channels.",
        "responses": {
          "200": {
            "description": "Session control result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Declared session or parameter error"
          }
        },
        "x-livepeer": {
          "framing": "json",
          "success": {
            "status": [
              200
            ]
          },
          "errors": [
            {
              "status": 400,
              "kind": "input_invalid"
            },
            {
              "status": 404,
              "kind": "unavailable"
            },
            {
              "status": 409,
              "kind": "busy"
            },
            {
              "status": 413,
              "kind": "input_unsupported"
            },
            {
              "status": 422,
              "kind": "input_invalid"
            },
            {
              "status": 500,
              "kind": "internal"
            },
            {
              "status": 502,
              "kind": "upstream_failed"
            },
            {
              "status": 503,
              "kind": "unavailable"
            },
            {
              "status": 504,
              "kind": "deadline_exceeded"
            }
          ]
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
