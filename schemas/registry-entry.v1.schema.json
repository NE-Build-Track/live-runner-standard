{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NE-Build-Track/live-runner-standard/schemas/registry-entry.v1.schema.json",
  "title": "Registry entry v1: the x-livepeer extension",
  "description": "A registry entry is an OpenAPI 3.1.0 document. This schema defines the x-livepeer object at its root. $defs/operation defines the x-livepeer object on each operation of a profile entry, and $defs/media the x-media object on schema fields that carry media. See SPEC.md.",
  "type": "object",
  "required": ["registry_entry", "profile", "kind"],
  "properties": {
    "registry_entry": {
      "const": 1
    },
    "profile": {
      "description": "The entry's ID; it matches the entry's path",
      "$ref": "#/$defs/profile_id"
    },
    "kind": {
      "description": "profile: a wire profile runners speak. shared: a shape other entries reuse, with components and no paths",
      "enum": ["profile", "shared"]
    },
    "extends": {
      "description": "A base entry whose behavior this one shares",
      "$ref": "#/$defs/profile_id"
    },
    "mode": {
      "enum": ["single-shot", "persistent"]
    },
    "capabilities": {
      "description": "The capabilities this profile serves, from capabilities.json",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "admission": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {
          "enum": ["candidate", "private"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "attempts": {
      "$ref": "#/$defs/attempts"
    },
    "readiness": {
      "description": "The self-test a runner passes before its health check answers 200",
      "type": "string",
      "minLength": 1
    },
    "presets": {
      "description": "Named presets or encoding profiles the profile accepts; a runner's attributes list the ones it offers",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "cost_hint": {
      "$ref": "#/$defs/cost_hint"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "profile"
          }
        }
      },
      "then": {
        "required": ["mode", "capabilities", "admission", "attempts"]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["mode"]},
            {"required": ["capabilities"]},
            {"required": ["admission"]},
            {"required": ["attempts"]},
            {"required": ["presets"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "profile_id": {
      "description": "<namespace>.<name>.v<major>",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+(-[a-z0-9]+)*)+\\.v[1-9][0-9]*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "attempts": {
      "description": "Who owns retries: the caller (the gateway must not retry) or the gateway",
      "enum": ["caller", "gateway"]
    },
    "pointer": {
      "description": "A JSON pointer (RFC 6901); the empty string is the whole value",
      "type": "string",
      "pattern": "^(/.*)?$"
    },
    "error_kind": {
      "enum": [
        "input_invalid",
        "input_unsupported",
        "busy",
        "unavailable",
        "deadline_exceeded",
        "output_failed",
        "upstream_failed",
        "internal",
        "input_unreadable"
      ]
    },
    "measure": {
      "enum": ["input_tokens", "output_tokens", "images", "audio_seconds", "media_seconds", "characters"]
    },
    "cost_hint": {
      "description": "Optional facts that let an app estimate wholesale cost before a call",
      "type": "object",
      "properties": {
        "typical_duration_s": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "description": "Work done per wall-clock second, by named setup, such as source seconds encoded per second",
          "type": "object",
          "additionalProperties": {
            "type": ["number", "null"]
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "description": "The x-livepeer object on each operation of a profile entry. The operation's operationId is the endpoint's name",
      "type": "object",
      "required": ["framing", "success", "errors"],
      "properties": {
        "framing": {
          "enum": ["json", "sse", "ndjson", "binary"]
        },
        "success": {
          "$ref": "#/$defs/success"
        },
        "errors": {
          "description": "Every error the runner returns, mapped to a base kind; anything unmapped is internal",
          "type": "array",
          "items": {
            "$ref": "#/$defs/error_mapping"
          }
        },
        "work_reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/work_report"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "attempts": {
          "description": "Overrides the entry's attempts for this endpoint",
          "$ref": "#/$defs/attempts"
        },
        "cost_hint": {
          "$ref": "#/$defs/cost_hint"
        },
        "session": {
          "$ref": "#/$defs/session"
        }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "description": "The HTTP statuses that can be success",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 200,
            "maximum": 299
          }
        },
        "final": {
          "description": "What must also hold at the end of the answer, where a status alone is not success",
          "type": "object",
          "required": ["in"],
          "properties": {
            "in": {
              "enum": ["body", "last-line", "last-event"]
            },
            "event": {
              "description": "The SSE event name that ends a successful answer",
              "type": "string"
            },
            "data": {
              "description": "The exact data of the event that ends a successful answer, such as [DONE]",
              "type": "string"
            },
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "equals": {}
          },
          "anyOf": [
            {"required": ["event"]},
            {"required": ["data"]},
            {"required": ["pointer", "equals"]}
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "error_mapping": {
      "description": "One error the runner returns. Every condition given must hold",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "in": {
          "enum": ["body", "last-line", "last-event"]
        },
        "event": {
          "type": "string"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "equals": {},
        "kind": {
          "$ref": "#/$defs/error_kind"
        },
        "note": {
          "type": "string"
        }
      },
      "dependentRequired": {
        "equals": ["pointer"],
        "pointer": ["in"],
        "event": ["in"]
      },
      "additionalProperties": false
    },
    "work_report": {
      "type": "object",
      "required": ["measure", "in"],
      "properties": {
        "measure": {
          "$ref": "#/$defs/measure"
        },
        "in": {
          "enum": ["body", "last-line", "last-event", "header"]
        },
        "event": {
          "type": "string"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "header": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "description": "How the caller asks for the report, when it must",
          "type": "object",
          "required": ["pointer", "value"],
          "properties": {
            "pointer": {
              "$ref": "#/$defs/pointer"
            },
            "value": {}
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        {"required": ["pointer"]},
        {"required": ["header"]}
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "field": {
          "description": "Where the value sits in the request body; absent means the whole body",
          "$ref": "#/$defs/pointer"
        },
        "kind": {
          "enum": ["inline", "body", "url", "storage-grant", "trickle"]
        },
        "media_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "description": "url: public, or deployment (only the deployment's own origins, so the profile is private)",
          "enum": ["public", "deployment"]
        },
        "sha256_field": {
          "description": "url: where the caller may give the content's sha256",
          "$ref": "#/$defs/pointer"
        },
        "grant": {
          "enum": ["s3-post-policy", "presigned-put"]
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "max_segment_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "inline"}}}, "then": {"required": ["max_bytes"]}},
        {"if": {"properties": {"kind": {"const": "body"}}}, "then": {"required": ["media_types"]}},
        {"if": {"properties": {"kind": {"const": "url"}}}, "then": {"required": ["origin"]}},
        {"if": {"properties": {"kind": {"const": "storage-grant"}}}, "then": {"required": ["grant"]}},
        {"if": {"properties": {"kind": {"const": "trickle"}}}, "then": {"required": ["channel", "media_types"]}}
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "field": {
          "description": "Where the value sits in the response body; absent means the whole body",
          "$ref": "#/$defs/pointer"
        },
        "kind": {
          "enum": ["inline", "body", "url", "storage-grant", "trickle"]
        },
        "media_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "expires": {
          "description": "url: when a returned URL expires, as a fixed lifetime or a response field",
          "type": "object",
          "properties": {
            "after_s": {
              "type": "integer",
              "minimum": 1
            },
            "field": {
              "$ref": "#/$defs/pointer"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "grant": {
          "enum": ["s3-post-policy", "presigned-put"]
        },
        "completion_record": {
          "description": "storage-grant: the key, under the granted prefix, written last",
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "max_segment_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "inline"}}}, "then": {"required": ["max_bytes"]}},
        {"if": {"properties": {"kind": {"const": "body"}}}, "then": {"required": ["media_types"]}},
        {"if": {"properties": {"kind": {"const": "url"}}}, "then": {"required": ["expires"]}},
        {"if": {"properties": {"kind": {"const": "storage-grant"}}}, "then": {"required": ["grant", "completion_record"]}},
        {"if": {"properties": {"kind": {"const": "trickle"}}}, "then": {"required": ["channel", "media_types"]}}
      ],
      "additionalProperties": false
    },
    "session": {
      "description": "For a persistent profile's session endpoint",
      "type": "object",
      "required": ["channels", "idle_timeout_s"],
      "properties": {
        "channels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["direction", "media_type"],
            "properties": {
              "direction": {
                "enum": ["in", "out"]
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "max_segment_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "timing": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "events": {
          "type": "object",
          "required": ["channel", "schema"],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "description": "A local reference to the event schema, such as #/components/schemas/Event",
              "type": "string",
              "pattern": "^#/"
            },
            "counter": {
              "description": "A field that grows with each event, so a reader can drop stale ones",
              "$ref": "#/$defs/pointer"
            }
          },
          "additionalProperties": false
        },
        "controls": {
          "description": "Control calls beyond start and stop, each the operationId of another operation in the entry",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "idle_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "drain_timeout_s": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "media": {
      "description": "The x-media object on a schema field that carries media",
      "type": "object",
      "required": ["by"],
      "properties": {
        "by": {
          "enum": ["inline", "body", "url", "storage-grant", "trickle"]
        },
        "accept": {
          "description": "Media types the field accepts",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "description": "The media type the field carries",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
